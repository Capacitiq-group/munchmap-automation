# PocketBase
POCKETBASE_URL=https://your-pocketbase-instance.example.com
POCKETBASE_ADMIN_EMAIL=admin@synkra.co.za
POCKETBASE_ADMIN_PASSWORD=change-me

# Paystack
# Use sk_test_... keys until you are ready to go live.
PAYSTACK_SECRET_KEY=sk_test_change_me
PAYSTACK_WEBHOOK_SECRET=sk_test_change_me

# Resend - all transactional email goes through this. No other provider.
RESEND_API_KEY=re_change_me

# Short links
# Keep this short - it gets printed on stickers, table cards, and menus.
SHORT_LINK_BASE_URL=https://mm.synkra.co.za

# Payout schedule (24h, Africa/Johannesburg time - UTC+2, no DST)
PAYOUT_TRIGGER_DAYS=mon,wed
PAYOUT_TRIGGER_HOUR=17

# Logging
LOG_LEVEL=INFO
